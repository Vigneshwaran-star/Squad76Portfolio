import { motion } from "framer-motion";
import { useEffect, useRef, useState } from "react";

const ShuffleHero = () => {
  return (
    
    <section className="w-full px-8 py-12 grid grid-cols-1 md:grid-cols-2 items-center gap-8 max-w-6xl mx-auto">
      <ShuffleGrid />
      <div>
        
        <h3 className="text-4xl md:text-6xl font-semibold">
        Mosaic of Memories

        </h3>
        <p className="text-base md:text-lg text-slate-700 my-4 md:my-6">
        A vibrant and dynamic display of cherished moments brought together like pieces of a mosaic. Each image tells a unique story, blending together to celebrate the beauty of life’s unforgettable experiences.
        </p>
        
      </div>
    </section>
  );
};

const shuffle = (array) => {
  let currentIndex = array.length,
    randomIndex;

  while (currentIndex != 0) {
    randomIndex = Math.floor(Math.random() * currentIndex);
    currentIndex--;

    [array[currentIndex], array[randomIndex]] = [
      array[randomIndex],
      array[currentIndex],
    ];
  }

  return array;
};

const squareData = [
  {
    id: 1,
    src: "src/assets/sqaud/IMG-20240920-WA0059.jpg",
  },
  {
    id: 2,
    src: "src/assets/sqaud/IMG-20240920-WA0079.jpg",
  },
  {
    id: 3,
    src: "src/assets/sqaud/IMG-20241027-WA0001.jpg",
  },
  {
    id: 4,
    src: "src/assets/sqaud/blac.jpg",
  },
 
];

const generateSquares = () => {
  return shuffle(squareData).map((sq) => (
    <motion.div
      key={sq.id}
      layout
      transition={{ duration: 1.5, type: "spring" }}
      className="w-full h-full"
      style={{
        backgroundImage: url(${sq.src}),
        backgroundSize: "cover",
      }}
    ></motion.div>
  ));
};

const ShuffleGrid = () => {
  const timeoutRef = useRef(null);
  const [squares, setSquares] = useState(generateSquares());

  useEffect(() => {
    shuffleSquares();

    return () => clearTimeout(timeoutRef.current);
  }, []);

  const shuffleSquares = () => {
    setSquares(generateSquares());

    timeoutRef.current = setTimeout(shuffleSquares, 3000);
  };

  return (
    <div className="grid grid-cols-2 grid-rows-2 h-[450px] gap-1">
      {squares.map((sq) => sq)}
    </div>
  );
};

export default ShuffleHero;